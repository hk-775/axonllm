{
  "schemaVersion": 1,
  "profile": "production-launch",
  "region": "us-east-1",
  "runtimeArn": "arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/AxonLLMRuntime-ABCDEFGHIJ",
  "qualifier": "production",
  "timeoutSeconds": 60,
  "maxResponseBytes": 10485760,
  "identities": {
