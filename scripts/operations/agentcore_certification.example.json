    "inactiveCredentialEnv": "AXON_INACTIVE_CREDENTIAL",
    "ungrantedCredentialEnv": "AXON_UNGRANTED_CREDENTIAL",
    "crossTenantCredentialEnv": "AXON_CROSS_TENANT_CREDENTIAL",
    "adminCredentialEnv": "AXON_ADMIN_CREDENTIAL",
    "viewerCredentialEnv": "AXON_VIEWER_CREDENTIAL"
  },
