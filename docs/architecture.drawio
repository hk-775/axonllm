        <!-- Title -->
        <mxCell id="title2" value="AxonLLM — Request Pipeline" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
