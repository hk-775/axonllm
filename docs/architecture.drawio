        <mxCell id="s14" value="14. Audit Trail&#xa;(SHA-256 Chain)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="840" y="220" width="120" height="50" as="geometry" />
