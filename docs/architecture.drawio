          <mxGeometry x="790" y="90" width="115" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="4–5. Model access&#xa;(project + user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
