        </mxCell>
        <mxCell id="path_direct" value="Direct path&#xa;router.execute_with_fallback&#xa;provider fallback chain + backoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#232F3E" vertex="1" parent="1">
