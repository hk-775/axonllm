          <mxGeometry x="460" y="508" width="90" height="25" as="geometry" />
        </mxCell>

        <!-- Detail boxes -->
        <mxCell id="box1" value="Routing strategies&#xa;&#xa;• Round-robin / weighted&#xa;• Least-latency&#xa;• Cost-optimized&#xa;• Smart (intent-aware, leaderboard)&#xa;• Ensemble (panel → quorum → synthesis)&#xa;• Fallback chain with exponential backoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="30" y="560" width="270" height="160" as="geometry" />
        </mxCell>
        <mxCell id="box2" value="Policy hierarchy (inheritance)&#xa;&#xa;org → business unit → project → env&#xa;&#xa;Budget: MIN (tightest wins)&#xa;Rate limit: MIN&#xa;Allowed models: INTERSECTION&#xa;PII redaction: OR (cannot be disabled)&#xa;PII types: UNION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="325" y="560" width="270" height="160" as="geometry" />
        </mxCell>
        <mxCell id="box3" value="Security pipeline&#xa;&#xa;• Unicode NFKD normalization&#xa;• Homoglyph-resistant injection patterns&#xa;• Streaming PII buffer (split tokens)&#xa;• SHA-256 hash-chain audit trail&#xa;  (head reloaded on restart)&#xa;• Event dispatch: webhook / SNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="620" y="560" width="270" height="160" as="geometry" />
        </mxCell>
        <mxCell id="box4" value="Multi-region (hub &amp; spoke)&#xa;&#xa;• Filter: health → model availability&#xa;• Active-passive failover&#xa;• Active-active weighted&#xa;• Data-residency zones&#xa;• SpokeHealthMonitor background task&#xa;  (skipped when single-region)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="915" y="560" width="270" height="160" as="geometry" />
        </mxCell>
        <mxCell id="box5" value="True streaming (SSE)&#xa;&#xa;• Opens provider stream directly —&#xa;  no blocking call, no double billing&#xa;• Pre-first-byte provider fallback&#xa;• Usage merged at end of stream&#xa;• PII re-injected per chunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="1210" y="560" width="270" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

