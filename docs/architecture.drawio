  <diagram id="pipeline" name="Request Pipeline">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title2" value="AxonLLM — Request Pipeline (15 Steps)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="450" y="10" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- Row 1: Steps 1-9 -->
        <mxCell id="s1" value="1. Auth&#xa;(OIDC / API Key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. Quota&#xa;(Policy Hierarchy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="180" y="80" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. Injection Detect&#xa;(Unicode NFKD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. PII Redaction&#xa;(Tokenize)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. Rate Limit&#xa;(Sliding Window)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="650" y="80" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6. Access Check&#xa;(Model Restrict)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="800" y="80" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="7. Budget Check&#xa;(Spend Limits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="950" y="80" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="8. Guardrails&#xa;(Input Filter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="1100" y="80" width="110" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="9. Cache&#xa;(LRU Lookup)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="1240" y="80" width="110" height="50" as="geometry" />
        </mxCell>

        <!-- Row 2: Steps 10-15 + LLM -->
        <mxCell id="s10" value="10. Region Route&#xa;(Hub → Spoke)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="30" y="220" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="11. Provider Route&#xa;(Strategy + Fallback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
          <mxGeometry x="190" y="220" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- LLM Provider -->
        <mxCell id="llm" value="LLM Provider&#xa;(Bedrock / Mantle /&#xa;Anthropic / OpenAI)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#4AB29A;gradientDirection=north;fillColor=#116D5B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=middle;verticalAlign=middle;align=center;html=1;fontSize=11;fontStyle=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;labelPosition=right" vertex="1" parent="1">
