        <mxCell id="s15" value="15. Cost Track&#xa;(Budget Alerts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
