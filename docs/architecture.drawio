        <mxCell id="p9" value="8. Request&#xa;guardrails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;fontColor=#232F3E" vertex="1" parent="1">
